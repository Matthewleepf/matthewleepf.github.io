
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft
  );

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
>
  <article class="content-container blog-article">
    <a class="back" href="/blog/">← All writing</a>

    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-GB", {
          dateStyle: "long",
        })}
      </time>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-article {
    font-family: var(--font-serif);
    max-width: 760px;
    padding-top: 4rem;
    padding-bottom: 7rem;
  }

  .back {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  header {
    margin: 3rem 0 4rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .prose {
    line-height: 1.85;
  }

  .prose :global(p) {
    margin: 1.25rem 0;
  }

  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin: 1.25rem 0;
  }

  .prose :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    border-radius: 4px;
    margin: 1.5rem 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
